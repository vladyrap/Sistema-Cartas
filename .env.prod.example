# EliteCards — PRODUCCIÓN. Copiá este archivo a `.env.prod` EN EL VPS y completá
# los valores reales ahí. NUNCA subas .env.prod a git (ya está en .gitignore).
#
#   cp .env.prod.example .env.prod
#   nano .env.prod        # completá los valores
#
# Generar secrets fuertes en el VPS:
#   POSTGRES_PASSWORD:   openssl rand -base64 24
#   JWT_SECRET:          openssl rand -base64 48   (mínimo 32 chars; el boot rechaza secrets débiles en prod)

# ─────────────────────────────  OBLIGATORIO  ─────────────────────────────

# Password de la Postgres interna de EliteCards (la usa el contenedor `db` y la
# arma el DATABASE_URL en el compose). Debe coincidir solo acá — no la repitas.
POSTGRES_PASSWORD=

# Secret de firma de JWT. 32+ caracteres aleatorios. El backend NO arranca en
# prod con un secret débil/por defecto.
JWT_SECRET=

# Tu dominio/subdominio de EliteCards (con https). Se usa para CORS, links de
# email y back_urls de MercadoPago. Reemplazá por el real.
ALLOWED_ORIGINS=https://cartas.tudominio.cl
FRONTEND_URL=https://cartas.tudominio.cl

# Primer super-admin que crea el bootstrap (init_db). Email + pass fuerte.
ADMIN_EMAIL=admin@tudominio.cl
ADMIN_PASSWORD=

# ─────────────────  PUERTO EN EL HOST (solo loopback)  ──────────────────
# El frontend se publica en 127.0.0.1:WEB_PORT. Cambialo si 18080 está ocupado
# en el VPS (verificá con:  ss -tlnp | grep 18080  ).
WEB_PORT=18080

# ───────────────────────  OPCIONAL (degrada a mock/no-op si falta)  ───────

# IA real (storylines, Content Engine, OCR de mazos, resúmenes). Sin esto, mock.
# AI_BACKEND=anthropic
# ANTHROPIC_API_KEY=

# MercadoPago cobros reales. El token va POR GREMIO en la app (guilds.mp_access_token),
# no acá. Acá solo el secret global del webhook para validar firma.
# MP_BACKEND=real
# MP_WEBHOOK_SECRET=

# Emails transaccionales (Resend). Sin esto, EMAIL_BACKEND=console.
# EMAIL_BACKEND=resend
# RESEND_API_KEY=

# Error tracking (Sentry). Sin DSN, no-op.
# SENTRY_DSN=

# Membresía mensual
MEMBERSHIP_PRICE_CLP=5990
MEMBERSHIP_EVENT_DISCOUNT_PCT=10
