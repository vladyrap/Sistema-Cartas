# ─────────────────────────────────────────────────────────────────────
#  EliteCards Frontend — variables de entorno (build-time, Vite)
#  Copiá a .env y completá. NUNCA subas .env a git.
#  Solo las vars que empiezan con VITE_ son visibles en el código cliente.
# ─────────────────────────────────────────────────────────────────────

# Base URL del backend (sin trailing slash).
# En dev usualmente: http://localhost:8000
# En prod: https://api.elitecards.tu-dominio
VITE_API_BASE=http://localhost:8000

# ────────────────────────────  Sentry  ────────────────────────────────
# DSN público del frontend. Vacío = sin error tracking en cliente.
# Crear proyecto JavaScript/React en Sentry → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
# Sampling de performance (0.0 = off, 1.0 = todas las pageviews).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
