# ─────────────────────────────────────────────────────────────────────
#  EliteCards Backend — variables de entorno
#  Copiá este archivo a .env y completá. NUNCA subas .env a git.
# ─────────────────────────────────────────────────────────────────────

# Database — SQLite para dev, Postgres para prod
DATABASE_URL=sqlite:///./elitecards.db
# Para Postgres en prod:
# DATABASE_URL=postgresql+psycopg2://elitecards:CHANGE_ME@db.host:5432/elitecards

REDIS_URL=redis://localhost:6379/0

# JWT — en prod, GENERA UNO con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# El boot FALLA en prod si esto es default/débil o <32 chars.
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Entorno: "dev" o "prod". En prod se activan HSTS + HTTPS redirect y se valida config.
ENV=dev

# CORS: lista separada por comas de orígenes autorizados (sin trailing slash).
# En prod NO debe contener "localhost".
ALLOWED_ORIGINS=http://localhost:5173

# ─────────────────────────────  Email  ────────────────────────────────
# Backend: "console" (dev), "smtp" (legacy) o "resend" (recomendado prod).
EMAIL_BACKEND=console
EMAIL_FROM=noreply@elitecards.local

# Resend (recomendado): https://resend.com — free 3k emails/mes.
# 1. Crear cuenta, verificar dominio.
# 2. EMAIL_FROM debe ser un email del dominio verificado.
# 3. Generar API key en Resend dashboard.
RESEND_API_KEY=

# SMTP (legacy): Gmail, AWS SES SMTP, Mailgun SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# URL pública del frontend (se usa para construir links en emails)
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────  AI  ──────────────────────────────────
# Backend: "anthropic" (Claude real) o "mock" (canned responses, dev).
AI_BACKEND=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────  MercadoPago  ──────────────────────────────
# Secret global del panel MP para validar firma HMAC del webhook.
# Cada Gremio tiene su access_token propio en guilds.mp_access_token.
MP_WEBHOOK_SECRET=

# ────────────────────────────  Sentry  ────────────────────────────────
# DSN del proyecto en Sentry. Vacío = error tracking deshabilitado.
# Obtené el DSN en https://sentry.io → proyecto → Settings → Client Keys (DSN).
SENTRY_DSN=
# Sampling de performance tracing (0.0 = off, 1.0 = todas las requests).
SENTRY_TRACES_SAMPLE_RATE=0.0

# ────────────────────────────  Discord OAuth  ────────────────────────────
# Crear app en https://discord.com/developers/applications
# - Identifications → general → CLIENT ID + CLIENT SECRET
# - OAuth2 → Redirects → registrar la URL del frontend, ej http://localhost:5173/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# ────────────────────────────  Pokémon TCG  ────────────────────────────
# Opcional. Mejora rate limit. Self-serve en https://pokemontcg.io
POKEMON_TCG_API_KEY=

# ────────────────────────  apitcg.com (OP, UA, Digimon)  ────────────────
# REQUERIDO para One Piece / Union Arena / Digimon / Dragon Ball Fusion.
# Free signup: https://apitcg.com/platform
APITCG_API_KEY=

# ────────────────────────────  Currency  ────────────────────────────
# Solo fallback si la API live falla. USD→CLP live via open.er-api.com.
USD_CLP_RATE=950
